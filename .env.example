# Personal AI API (Pi production services use /etc/personal-ai/*.env)
PAI_DB_PATH=/var/lib/pai-api/control-plane.sqlite3
PAI_BOOTSTRAP_TOKEN=
PAI_NODE_ENROLLMENT_TOKEN=

# Node agent
PAI_API_URL=http://127.0.0.1:8000
PAI_HTTP_TRUST_ENV=false
PAI_NODE_ID=pi5
PAI_TAILSCALE_IP=
PAI_NODE_TOKEN_FILE=/var/lib/pai-agent/node-token
PAI_NODE_PENDING_DIR=/var/lib/pai-agent/pending-results

# Explicit context indexing; token has context:write only.
PAI_CONTEXT_INDEX_TOKEN_FILE=~/.config/personal-ai/context-index-token
PAI_CONTEXT_INDEX_ROOTS=/home/bchbenjamin/Documents
