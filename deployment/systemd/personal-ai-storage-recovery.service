[Unit]
Description=Recover Personal AI core services from verified microSD state
After=local-fs.target
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/personal-ai-storage-recovery.py
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
