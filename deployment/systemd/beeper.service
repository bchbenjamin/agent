[Unit]
Description=Beeper Desktop Messaging Service
After=network.target lightdm.service user-1000.slice
Wants=lightdm.service
StartLimitIntervalSec=5min
StartLimitBurst=4

[Service]
Type=simple
User=bchbenjamin
Group=bchbenjamin
WorkingDirectory=/home/bchbenjamin
Environment="DISPLAY=:0"
Environment="WAYLAND_DISPLAY=wayland-0"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
ExecStartPre=/bin/sh -c 'for i in $(seq 1 90); do [ -S /run/user/1000/wayland-0 ] && [ -S /run/user/1000/bus ] && exit 0; sleep 1; done; echo "Wayland or D-Bus session socket not ready" >&2; exit 1'
ExecStart=/home/bchbenjamin/Applications/Beeper.AppImage
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
