#!/usr/bin/python3
"""Narrow root helper: fixed systemd actions and command execution as bchbenjamin."""
import os
import re
import subprocess
import sys

ALLOWED_SERVICES = {
    "beeper.service",
    "lightdm.service",
    "wayvnc.service",
    "tailscaled.service",
    "personal-ai-api.service",
    "personal-ai-mcp.service",
}
PRIVILEGE_ESCALATORS = {"sudo", "su", "pkexec", "doas", "runuser"}
TARGET_USER = "bchbenjamin"
TARGET_UID = 1000
TARGET_HOME = "/home/bchbenjamin"


def user_exec(argv: list[str]) -> int:
    if not argv:
        print("user-exec requires a command after --", file=sys.stderr)
        return 2
    if any(arg.rsplit("/", 1)[-1] in PRIVILEGE_ESCALATORS for arg in argv):
        print("privilege escalation commands are blocked", file=sys.stderr)
        return 3
    if argv[0].rsplit("/", 1)[-1] in {"bash", "sh", "zsh", "dash"} and re.search(
        r"\b(sudo|su|pkexec|doas|runuser)\b", " ".join(argv[1:])
    ):
        print("privilege escalation commands are blocked", file=sys.stderr)
        return 3
    env = os.environ.copy()
    env.update({
        "HOME": TARGET_HOME,
        "USER": TARGET_USER,
        "LOGNAME": TARGET_USER,
        "XDG_RUNTIME_DIR": "/run/user/1000",
        "DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/user/1000/bus",
    })
    result = subprocess.run(
        ["/usr/sbin/runuser", "--preserve-environment", "-u", TARGET_USER, "--", *argv],
        env=env, stdin=subprocess.DEVNULL, check=False,
    )
    return result.returncode


def main() -> int:
    if os.geteuid() != 0:
        print("must be invoked through the restricted sudoers rule", file=sys.stderr)
        return 126
    args = sys.argv[1:]
    if len(args) == 2 and args[0] == "service-restart":
        service = args[1]
        if service not in ALLOWED_SERVICES:
            print("service is not allowlisted", file=sys.stderr)
            return 3
        return subprocess.run(
            ["/usr/bin/systemctl", "restart", service],
            stdin=subprocess.DEVNULL, check=False, timeout=30,
        ).returncode
    if len(args) >= 2 and args[0] == "user-exec" and args[1] == "--":
        return user_exec(args[2:])
    print("usage: pai-privileged service-restart SERVICE | user-exec -- COMMAND [ARGS...]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
