# Install only after confirming public HTTPS reachability and DNS.
# Backends remain loopback-only. All credentials are enforced by the upstream.
api.hermes.bchbenjamin.in {
    @agent path /v1/chat/completions /v1/responses /v1/models /v1/capabilities /v1/runs /v1/runs/* /api/sessions /api/sessions/*
    @control path /v1/auth/me /v1/nodes /v1/nodes/* /v1/tasks /v1/tasks/* /v1/context/query
    handle @agent {
        reverse_proxy 127.0.0.1:8642 {
            flush_interval -1
        }
    }
    handle @control {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        respond 404
    }
}
mcp.hermes.bchbenjamin.in {
    handle /mcp {
        reverse_proxy 127.0.0.1:8765 {
            header_up Host 127.0.0.1:8765
            flush_interval -1
        }
    }
    handle {
        respond 404
    }
}
