# Hermes environment configuration template
# Populate with real credentials on the target node; do NOT commit populated files.

# Layer 1: AI Gateway Client Key
AI_GATEWAY_API_KEY=replace-with-a-valid-ai-gateway-client-key

# Layer 2: Personal AI API Server Downstream Key (generate via: openssl rand -hex 32)
API_SERVER_ENABLED=true
API_SERVER_KEY=replace-with-a-random-64-character-hex-key
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_MODEL_NAME=hermes

# Personal AI API client credential (issue a distinct scoped token for Hermes).
# Suggested scopes: context:read,nodes:read,files:read,terminal:execute,services:manage
PAI_API_TOKEN=pai_replace-with-a-client-scoped-token

# Simular Box Remote Execution Key (optional; populate if Box tools are needed)
MCP_BOX_API_KEY=cb_replace-with-your-box-key
