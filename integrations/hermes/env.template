# Hermes environment configuration template
# Populate with real credentials on the target node; do NOT commit populated files.

# Layer 1: AI Gateway Client Key
AI_GATEWAY_API_KEY=replace-with-a-valid-ai-gateway-client-key

# Layer 2: Personal AI API Server Downstream Key (generate via: openssl rand -hex 32)
